# Copy to .env (never committed). One secret per line, NAME=value.

# The agent's model — set ONE of these (OpenAI is used when both are set):
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_MODEL=gpt-5.5

# Seals each conversation (HMAC) so a page cannot rewrite it. Any long random string.
WARDEN_SESSION_SECRET=

# Only to deploy your own Warden (it has no owner: this key has no powers afterwards).
# DEPLOYER_PRIVATE_KEY=

# Optional overrides
# PACIFIC_RPC_URL=https://rpc.pharos.xyz
# WARDEN_ADDRESS=0x02fa5869a0Abe62C97c1D1c65df878783Dc11418
